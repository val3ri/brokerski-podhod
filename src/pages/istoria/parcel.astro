---
import Layout from '../../layouts/Layout.astro';
import StoryPanels from '../../components/StoryPanels.astro';
import { stories } from '../../data/stories';

const story = stories.find((s) => s.slug === 'parcel')!;
---

<Layout title={`${story.title} — Sonar Development Company`}>
  <StoryPanels story={story} />
</Layout>
