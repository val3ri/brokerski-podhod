---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SplitSection from '../components/SplitSection.astro';
import PropertyPreviewMap from '../components/PropertyPreviewMap.astro';
import agent1 from '../assets/team/agent-1.jpg';
import agent2 from '../assets/team/agent-2.jpg';
import { buildings } from '../data/buildings';

// Services. Pictures come from src/assets/uslugi/<key>.(jpg|png|webp) — drop a file with that
// name in and it's used; until then the card shows its ink-line icon large.
// TODO: описанията да се потвърдят от клиента
const serviceImages = import.meta.glob<{ default: ImageMetadata }>('../assets/uslugi/*.{jpg,jpeg,png,webp}', { eager: true });
const imageFor = (key: string) =>
  Object.entries(serviceImages).find(([path]) => path.split('/').pop()!.split('.')[0] === key)?.[1].default;

const services = [
  { key: 'pokupka', label: 'Покупка на апартамент или къща',
    text: 'Търсим имота заедно с вас, ходим на огледите и проверяваме документите, преди да подпишете.',
    icon: '<path d="M6 24 L24 8 L42 24" /><path d="M10 22 V40 H38 V22" /><rect x="20" y="28" width="8" height="12" />' },
  { key: 'prodazhba', label: 'Продажба на имот',
    text: 'Реалистична оценка, професионално представяне на имота и преговори до финалната сделка.',
    icon: '<path d="M8 8 H26 L40 22 L26 36 L8 18 Z" /><circle cx="16" cy="16" r="2.5" fill="var(--ink)" stroke="none" />' },
  { key: 'parceli', label: 'Парцели и терени за строеж',
    text: 'Намираме терена за вашата идея и проверяваме какво и колко може да се построи на него.',
    icon: '<rect x="8" y="10" width="32" height="28" stroke-dasharray="4 3" /><path d="M16 38 V28 L24 20 L32 28 V38" />' },
  { key: 'stroitelstvo', label: 'Управление на строителния процес',
    text: 'От проекта и разрешителните до Акт 16 — координираме архитекти, строители и институции.',
    icon: '<path d="M10 40 V10" /><path d="M10 12 H36" /><path d="M30 12 V20" /><path d="M10 18 H22" /><rect x="6" y="30" width="10" height="10" />' },
];

const base = import.meta.env.BASE_URL;
---

<Layout title="Sonar Development Company — недвижими имоти в София">
  <Hero />

  <SplitSection kicker="Кои сме ние" id="koi-sme-nie" plain>
    <Fragment slot="text">
      <h2>Хората зад <span class="accent">агенцията</span></h2>
      <p>Работим с клиенти в София вече години наред — седим на масата с вас, обикаляме имотите заедно, подреждаме документите вместо вас.</p>
    </Fragment>
    <Fragment slot="visual">
      <div class="team-photos">
        <!-- TODO: реални имена и длъжности -->
        <div class="team-photo team-photo-1" tabindex="0">
          <Image src={agent1} alt="Агент на Sonar" width={320} height={420} />
          <div class="team-photo-info">
            <strong>Име Фамилия</strong>
            <span>Длъжност</span>
          </div>
        </div>
        <div class="team-photo team-photo-2" tabindex="0">
          <Image src={agent2} alt="Агент на Sonar" width={320} height={420} />
          <div class="team-photo-info">
            <strong>Име Фамилия</strong>
            <span>Длъжност</span>
          </div>
        </div>
      </div>
    </Fragment>
  </SplitSection>

  <!-- Services: full-width cards (picture + what we actually do) -->
  <section class="section bg-paper2" id="uslugi">
    <div class="services-wrap">
      <div class="services-head" data-reveal>
        <span class="kicker">Какво предлагаме</span>
        <h2>Услуги</h2>
        <p>От първия разговор до подписването — и отвъд него.</p>
      </div>
      <div class="services">
        {services.map((s, i) => {
          const img = imageFor(s.key);
          return (
            <article class="service-card" data-reveal style={`--i:${i}`}>
              <div class="service-media">
                {img ? (
                  <Image src={img} alt={s.label} width={600} height={450} />
                ) : (
                  <svg viewBox="0 0 48 48" fill="none" stroke="var(--sonar-teal)" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" set:html={s.icon} />
                )}
              </div>
              <h3>{s.label}</h3>
              <p>{s.text}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Active buildings: no visual/text split — a 4-up showcase grid is the content itself -->
  <section class="section" data-reveal>
    <div class="buildings-wrap">
      <span class="kicker">Обекти</span>
      <h2>Текущи <span class="accent">предложения</span></h2>
      <div class="buildings">
        {buildings.map((b, i) => (
          <a class="building-card" href={`${base}obekti/${b.slug}`} data-reveal style={`--i:${i}`}>
            <div class="building-photo-wrap">
              {b.images.length > 0 ? (
                <Image class="building-photo" src={b.images[0]} alt={b.name} width={320} height={240} />
              ) : (
                <div class="building-photo building-photo-placeholder">
                  <!-- TODO: реална снимка на обекта -->
                  <span>снимка</span>
                </div>
              )}
              <span class="building-status">{b.status}</span>
            </div>
            <strong>{b.name}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SplitSection kicker="Имоти" bg="paper2">
    <Fragment slot="text">
      <h2>Къде са <span class="accent">те</span>?</h2>
      <p>Всеки имот за продажба се издига в плътно черно върху рисувана 3D карта на града — вижте къде точно и какво предлагаме.</p>
      <a class="btn" href={`${base}imoti`}>Разгледай картата →</a>
    </Fragment>
    <Fragment slot="visual">
      <PropertyPreviewMap />
    </Fragment>
  </SplitSection>

  <!-- Contacts: no visual side — a form is the goal, splitting it doesn't help -->
  <section id="kontakti" class="section bg-paper" data-reveal>
    <div class="frame comic-box">
      <div class="contact-grid">
        <div class="contact-info">
          <span class="kicker">Контакти</span>
          <h2>Да <span class="accent">поговорим</span></h2>
          <p>
            Телефон: <a href="tel:+359000000000">+359 00 000 0000</a><br />
            Viber: <a href="viber://chat">+359 00 000 0000</a><br />
            Офис: ул. „Примерна" 1, София
            <!-- TODO: реален адрес и телефон -->
          </p>
        </div>
        <form class="contact-form">
          <input type="text" name="name" placeholder="Име" required />
          <input type="tel" name="phone" placeholder="Телефон" required />
          <textarea name="message" placeholder="Съобщение" rows="3"></textarea>
          <button class="btn" type="submit">Изпрати</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  // scroll-reveal: fade+slide in once, then stay. Full skip for prefers-reduced-motion.
  const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion) {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      }
    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => io.observe(el));
  }

  // team photo cards: hover brings that photo to front + reveals its info — pure CSS
  // (:hover, see the styles below), no JS needed.
</script>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .6s ease, transform .6s ease;
    transition-delay: calc(var(--i, 0) * 90ms);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  .section {
    min-height: 80vh;
    padding: 60px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
  }
  .section.bg-paper2 {
    background: var(--paper2);
  }
  .frame {
    width: min(880px, 94vw);
    padding: 40px 48px;
  }
  h2 {
    font-size: clamp(30px, 5vw, 44px);
    margin-bottom: 16px;
  }
  p {
    font-size: 20px;
    color: var(--dim);
  }

  .team-photos {
    position: relative;
    width: 100%;
    min-height: 400px;
  }
  .team-photo {
    position: absolute;
    width: 50%;
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    background: var(--paper2);
    overflow: hidden;
  }
  .team-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .team-photo-1 {
    top: 0;
    left: 0;
    z-index: 1;
  }
  .team-photo-2 {
    bottom: 0;
    right: 0;
    z-index: 2;
  }
  /* hovering brings that photo to the front, no matter which one was on top */
  .team-photo:hover {
    z-index: 3;
  }

  .team-photo-info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
    padding: 16px;
    background: rgba(20, 20, 20, .82);
    color: var(--paper);
    opacity: 0;
    transition: opacity .25s ease;
  }
  .team-photo-info strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
  }
  .team-photo-info span {
    font-size: 15px;
    opacity: .85;
  }
  .team-photo:hover .team-photo-info,
  .team-photo:focus-visible .team-photo-info {
    opacity: 1;
  }

  .buildings-wrap {
    width: min(1100px, 94vw);
  }
  .buildings {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .building-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  .building-photo-wrap {
    position: relative;
    transition: transform .2s ease;
  }
  .building-card:hover .building-photo-wrap {
    transform: translateY(-4px);
  }
  .building-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    box-shadow: 0 10px 26px rgba(44, 43, 40, .14);
    transition: box-shadow .2s ease;
  }
  .building-card:hover .building-photo {
    box-shadow: 0 16px 34px rgba(44, 43, 40, .2);
  }
  .building-photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f6f5;
    color: var(--dim);
    font-style: italic;
    font-size: 14px;
  }
  .building-status {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--paper);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ink);
    box-shadow: 0 2px 8px rgba(44, 43, 40, .18);
  }
  .building-card strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
  }

  .services-wrap { width: min(1180px, 94vw); }
  .services-head { max-width: 640px; margin-bottom: 36px; }
  .services-head h2 { margin-top: 12px; }
  .services { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .service-card { display: flex; flex-direction: column; gap: 10px; }
  .service-media {
    aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper);
    border: 2px solid var(--ink); box-shadow: 5px 5px 0 var(--ink);
    display: grid; place-items: center;
  }
  .service-media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .service-card:hover .service-media :global(img) { transform: scale(1.04); }
  .service-media svg { width: 34%; height: auto; }
  .service-card h3 { font-size: 20px; font-weight: 500; margin-top: 8px; }
  .service-card p { font-size: 16px; line-height: 1.5; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .contact-info h2 { margin-top: 10px; }

  .contact-form {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .contact-form input,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 18px;
    padding: 8px 4px;
    border: none;
    border-bottom: 2px solid var(--dim);
    background: transparent;
    color: var(--ink);
    transition: border-color .15s ease;
  }
  .contact-form textarea {
    resize: vertical;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .contact-form button {
    align-self: flex-start;
    margin-top: 6px;
  }

  @media (max-width: 1000px) {
    .services { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 700px) {
    .buildings { grid-template-columns: repeat(2, 1fr); }
    .services { grid-template-columns: 1fr; gap: 28px; }
    .frame { padding: 26px 22px; }
    .contact-grid { grid-template-columns: 1fr; gap: 24px; }
    .contact-form { margin-top: 0; }
  }
</style>
