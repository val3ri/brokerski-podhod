  .maplibregl-popup-close-button { font-size: 20px; color: var(--ink); }

  @media (max-width: 720px) {
    .map-wrap header h1 { font-size: 22px; }

    /* bottom sheet: collapsed to a peeking "Имоти (N)" handle; tap it to slide the full list up */
    .map-wrap aside {
      position: fixed; z-index: 30; left: 0; right: 0; top: auto; bottom: 0; width: auto;
      max-height: 65vh; max-width: none;
      display: flex; flex-direction: column;
      padding: 0 14px 14px;
      transform: translateY(calc(100% - 54px));
      transition: transform .3s ease;
    }
    .map-wrap aside.expanded { transform: translateY(0); }

    .map-wrap aside h2 {
      flex: none; margin: 0 -14px; padding: 15px 14px 8px; cursor: pointer; user-select: none;
      background: var(--paper2);
    }
    .map-wrap aside h2 .chevron { display: inline-block; }
