  .map-wrap aside h2 .chevron { display: none; margin-left: auto; font-size: 14px; transition: transform .25s; }
  .map-wrap .card {
    border: 2px solid var(--ink); padding: 8px 10px; margin-bottom: 10px; cursor: pointer;
    background: var(--paper2); transition: transform .1s, box-shadow .1s;
    font-family: var(--font-body);
  }
  .map-wrap .card:hover { transform: translate(-2px,-2px); box-shadow: 3px 3px 0 var(--ink); }
  .map-wrap .card .t { font-size: 18px; font-weight: bold; }
  .map-wrap .card .d { font-size: 15px; color: #333; display: flex; justify-content: space-between; }
  .map-wrap .card .tag { display: inline-block; font-size: 12px; border: 1.5px solid var(--ink); padding: 0 6px; margin-top: 3px; background: var(--paper); }
  .map-wrap .filters { display: grid; gap: 6px; margin-bottom: 10px; }
  .map-wrap .filters select {
    font-family: var(--font-body); font-size: 14px; color: var(--ink);
    background: var(--paper); border: 2px solid var(--ink); border-radius: 0; padding: 5px 8px;
  }
  .map-wrap .no-results { font-size: 14px; color: var(--dim); padding: 6px 0; }

  .map-wrap .legend {
    position: absolute; z-index: 20; right: 18px; bottom: 34px; padding: 10px 14px; font-size: 15px;
    font-family: var(--font-body);
  }
  .map-wrap .legend div { display: flex; align-items: center; gap: 8px; margin: 3px 0; }
  .map-wrap .sw { width: 22px; height: 15px; border: 2px solid var(--ink); flex: none; }
  .map-wrap .sw.b { background: var(--ink); }
  .map-wrap .sw.g { background: #d6cfbe; }
  .map-wrap .sw.p { border-style: dashed; background: repeating-linear-gradient(45deg, transparent 0 4px, #2c2b2855 4px 6px); }
  .map-wrap .sw.a { border-radius: 50%; border-style: dotted; background: #2c2b2822; }

  .map-wrap .hint {
    position: absolute; z-index: 20; left: 18px; bottom: 34px; padding: 6px 12px; font-size: 14px;
    color: var(--dim); font-family: var(--font-body);
  }


  /* comic popups — MapLibre-injected, must stay global (see note above) */
  .maplibregl-popup-content {
    font-family: var(--font-body); background: var(--paper);
    border: 3px solid var(--ink); border-radius: 0; box-shadow: 5px 5px 0 var(--ink);
    padding: 10px 14px; min-width: 200px;
  }
  .maplibregl-popup-tip { border-top-color: var(--ink) !important; }
  .pop-img { display: block; width: 100%; height: 110px; object-fit: cover; border: 2px solid var(--ink); margin-bottom: 6px; }
  .pop-t { font-family: var(--font-display); font-weight: 700; font-size: 22px; line-height: 1.1; }
  .pop-d { font-size: 16px; margin: 4px 0; }
  .pop-a {
