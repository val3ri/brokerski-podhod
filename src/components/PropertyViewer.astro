---
// Top of /obekti/<slug>: building → floor → apartment.
//  - 3D: real .glb or procedural placeholder (src/scripts/viewer3d.ts)
//  - 2D: façade image with clickable floors (Floor.facade) → the floor's plan with clickable
//    apartments (Floor.plan + Floor.units). Also the fallback when WebGL is missing / the model fails.
// The page's apartments table reacts to the same state (see [slug].astro).
import { Image } from 'astro:assets';
import { type Building, STATUS_LABEL, floorsOf, suiteName, floorsText } from '../data/buildings';

interface Props { building: Building }
const { building } = Astro.props;
const base = import.meta.env.BASE_URL;
const viewer = building.viewer!;

const facadeImage = viewer.image ?? building.images[0];
const has3D = !!(viewer.model || viewer.procedural);
const floors = floorsOf(building);   // top first, like a lift panel
const statusOf = Object.fromEntries(building.suites.map((s) => [s.number, s.status]));
const nameOf = Object.fromEntries(building.suites.map((s) => [s.number, suiteName(s)]));
const pts = (p: [number, number][]) => p.map((xy) => xy.join(',')).join(' ');
// name tag sits centred on the top edge of the apartment's outline (only the topmost points
// count, so an L-shaped outline doesn't pull the tag over the neighbour)
const tagPos = (p: [number, number][]) => {
  const top = Math.min(...p.map((xy) => xy[1]));
  const xs = p.filter((xy) => xy[1] - top < 0.5).map((xy) => xy[0]);
  return `left:${(Math.min(...xs) + Math.max(...xs)) / 2}%;top:${top}%`;
};

const data = {
  modelUrl: viewer.model ? `${base}${viewer.model}` : undefined,
  procedural: viewer.procedural,
  has3D,
  floors: floors.map((f) => ({ number: f.number, label: f.label, level: f.level, hasPlan: !!f.plan, planSrc: f.plan?.src })),
  suites: building.suites.map((s) => ({
    number: s.number,
    name: suiteName(s),
    type: s.type,
    size: s.size,
    floors: s.floors,
    floorsText: floorsText(s),
    status: s.status,
    statusLabel: STATUS_LABEL[s.status],
    price: s.price,
    href: `${base}obekti/${building.slug}/${s.number}`,
  })),
};
const available = (f: number) => building.suites.filter((s) => s.floors.includes(f) && s.status === 'available').length;
const hasUnits = (f: number) => building.suites.some((s) => s.floors.includes(f));
---

<div class="viewer" id="viewer" data-mode={has3D ? '3d' : 'image'} data-plan-style="render">
  <script type="application/json" class="viewer-data" set:html={JSON.stringify(data)} />

  <div class="stage comic-box">
    {has3D && <div class="stage-3d"><p class="stage-loading">Зареждане на 3D модела…</p></div>}
    <div class="stage-image">
      {facadeImage && (
        <div class="image-box facade-view" style={`--ratio: ${facadeImage.width / facadeImage.height}`}>
          <Image src={facadeImage} alt={building.name} width={1400} loading="eager" />
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="Етажи">
            {floors.filter((f) => f.facade).map((f) => (
              <polygon class="floor-shape" points={pts(f.facade!)} data-floor={f.number}>
                <title>{f.label}</title>
              </polygon>
            ))}
          </svg>
        </div>
      )}
      {floors.filter((f) => f.plan).map((f) => (
        <div class={`image-box plan-view${f.render ? ' has-render' : ''}`} data-floor={f.number} hidden style={`--ratio: ${f.plan!.width / f.plan!.height}`}>
          <Image class="floor-plan-img" src={f.plan!} alt={`План — ${f.label}`} width={1600} />
          {f.render && <Image class="floor-render-img" src={f.render} alt={`Визуализация — ${f.label}`} width={1800} />}
          {f.units && (
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="Апартаменти">
              {Object.entries(f.units).map(([unit, outline]) => (
                <polygon class={`unit-shape ${statusOf[unit] ?? 'sold'}`} points={pts(outline)} data-unit={unit}>
                  <title>{nameOf[unit] ?? unit}</title>
                </polygon>
              ))}
            </svg>
          )}
          {f.rooms && (
            <div class="rooms" aria-hidden="true">
              {f.rooms.map((r) => (
                <span class="room" style={`left:${r.x}%;top:${r.y}%`}><b>{r.name}</b>{r.area && <i>{r.area}</i>}</span>
              ))}
            </div>
          )}
          {f.units && Object.entries(f.units).map(([unit, outline]) => (
            <span class={`unit-tag ${statusOf[unit] ?? 'sold'}`} style={tagPos(outline)}>
              <span class="tag-long">{nameOf[unit] ?? unit}</span>
              <span class="tag-short">{(nameOf[unit] ?? unit).split(' ').pop()}</span>
            </span>
          ))}
          {f.render && <span class="render-note">Илюстративна визуализация</span>}
        </div>
      ))}
    </div>
    <div class="tooltip" hidden></div>

    <button type="button" class="plan-back" hidden>← Цялата сграда</button>
    <button type="button" class="zoom-out" hidden>← Целия етаж</button>
    <div class="plan-style" role="group" aria-label="Изглед на етажа" hidden>
      <button type="button" data-style="render">Визуализация</button>
      <button type="button" data-style="plan">План</button>
    </div>
    <p class="plan-label" hidden></p>
    <div class="zoom-ctrl" role="group" aria-label="Мащаб" hidden>
      <button type="button" data-zoom="in" aria-label="Увеличи">+</button>
      <button type="button" data-zoom="out" aria-label="Намали">−</button>
    </div>
    {has3D && facadeImage && (
      <div class="mode-toggle" role="group" aria-label="Изглед">
        <button type="button" data-mode="3d">3D</button>
        <button type="button" data-mode="image">Снимка</button>
      </div>
    )}
    <div class="legend">
      <span><i class="sw available"></i>свободен</span>
      <span><i class="sw reserved"></i>резервиран</span>
      <span><i class="sw sold"></i>продаден</span>
    </div>
    <p class="stage-hint">изберете етаж</p>
    <div class="unit-bar" hidden></div>
  </div>

  {floors.length > 0 && (
    <nav class="floors" aria-label="Етажи">
      <button type="button" class="floor-btn whole" data-floor="">Цялата сграда</button>
      {floors.map((f) => (
        <button type="button" class="floor-btn" data-floor={f.number}>
          <b>{f.number < 0 ? 'Г' : f.number}</b>
          <small>{!hasUnits(f.number) ? f.label.toLowerCase() : available(f.number) ? `${available(f.number)} своб.` : 'няма своб.'}</small>
        </button>
      ))}
    </nav>
  )}

  <div class="floor-panel" hidden>
    <h3 class="floor-title"></h3>
    <div class="units"></div>
    <a class="plan-link" target="_blank" rel="noopener" hidden>План на етажа ↗</a>
  </div>
</div>

<script>
  import { createLens } from '../scripts/lens';

  type Suite = { number: string; name: string; type: string; size: string; floors: number[]; floorsText: string;
    status: 'available' | 'reserved' | 'sold'; statusLabel: string; price?: string; href: string };
  type FloorInfo = { number: number; label: string; level?: string; hasPlan: boolean; planSrc?: string };

  const freeText = (n: number) => n === 0 ? 'няма свободни' : n === 1 ? '1 свободен' : `${n} свободни`;

  document.querySelectorAll<HTMLElement>('.viewer').forEach(init);

  async function init(root: HTMLElement) {
    const data = JSON.parse(root.querySelector('.viewer-data')!.textContent!) as {
      modelUrl?: string; procedural?: any; has3D: boolean; floors: FloorInfo[]; suites: Suite[] };
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string) => [...root.querySelectorAll<T>(sel)];
    const stage3d = $('.stage-3d');
    const tooltip = $('.tooltip')!, panel = $('.floor-panel')!, card = $('.unit-bar')!;
    const hint = $('.stage-hint')!, back = $('.plan-back')!, planLabel = $('.plan-label')!, planLink = $<HTMLAnchorElement>('.plan-link')!;
    const facadeView = $('.facade-view');
    const planViews = $$('.plan-view');
    const zoomOut = $('.zoom-out')!, planStyle = $('.plan-style')!, zoomCtrl = $('.zoom-ctrl')!;
    const stageImage = $('.stage-image')!;
    // magnifier so the small labels can be read (src/scripts/lens.ts)
    const lens = createLens(stageImage.parentElement!, stageImage, zoomCtrl, () => showTooltip(null, 0, 0));
    const floorBtns = $$<HTMLButtonElement>('.floor-btn');
    const floorShapes = $$<SVGPolygonElement>('.floor-shape');
    const unitShapes = $$<SVGPolygonElement>('.unit-shape');
    // the page's apartments table, outside this component
    const rows = [...document.querySelectorAll<HTMLElement>('[data-suite-row]')];

    let state: { floor: number | null; unit: string | null } = { floor: null, unit: null };
    let view3d: import('../scripts/viewer3d').Viewer3D | null = null;

    const floorInfo = (f: number) => data.floors.find(x => x.number === f);
    const floorTitle = (f: number) => {
      const i = floorInfo(f);
      return i ? `${i.label}${i.level ? ` · кота ${i.level}` : ''}` : `Етаж ${f}`;
    };
    const suitesOn = (f: number) => data.suites.filter(s => s.floors.includes(f));
    const freeOn = (f: number) => suitesOn(f).filter(s => s.status === 'available').length;
    const suite = (n: string | null) => n ? data.suites.find(s => s.number === n) : undefined;

    // 2D: façade when no floor is picked, the floor's plan when it has one
    function showStageImage() {
      const planned = root.dataset.mode === 'image' && state.floor !== null && !!floorInfo(state.floor)?.hasPlan;
      if (facadeView) facadeView.hidden = planned;
      planViews.forEach(v => v.hidden = !planned || +v.dataset.floor! !== state.floor);
      back.hidden = !planned || !!state.unit;
      planLabel.hidden = !planned;
      const view = planned ? planViews.find(v => +v.dataset.floor! === state.floor) : undefined;
      planStyle.hidden = !view?.classList.contains('has-render');
      zoomCtrl.hidden = !planned;
      lens.reset();
      zoomTo(view);
      if (planned) planLabel.textContent = floorTitle(state.floor!);
      root.classList.toggle('plan-open', planned);
    }

    // after picking an apartment, the zoomed floor is what matters: make sure the whole stage is on
    // screen (just under the sticky header) instead of scrolling down to the card, which used to
    // push the zoomed apartment partly out of view. The card sits right below the stage.
    function revealStage() {
      const header = document.querySelector('.site-header')?.getBoundingClientRect().height ?? 0;
      const r = stageEl.getBoundingClientRect();
      const fits = r.top >= header && r.bottom <= window.innerHeight;
      if (!fits) {
        window.scrollTo({
          top: window.scrollY + r.top - header - 12,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      }
    }

    function set(floor: number | null, unit: string | null = null, opts: { scroll?: boolean } = {}) {
      state = { floor, unit };
      view3d?.setState(floor, unit);
      showStageImage();

      floorBtns.forEach(b => b.classList.toggle('active', (b.dataset.floor || null) === (floor === null ? null : String(floor))));
      floorShapes.forEach(p => p.classList.toggle('active', +p.dataset.floor! === floor));
      unitShapes.forEach(p => p.classList.toggle('active', p.dataset.unit === unit));
      hint.hidden = floor !== null;
      rows.forEach(r => {
        const rowFloors = r.dataset.floors!.split(',').map(Number);
        r.classList.toggle('on-floor', floor !== null && rowFloors.includes(floor));
        r.classList.toggle('selected', r.dataset.unit === unit);
      });

      panel.hidden = floor === null;
      if (floor !== null) {
        const list = suitesOn(floor);
        $('.floor-title')!.textContent = list.length ? `${floorTitle(floor)} · ${freeText(freeOn(floor))}` : floorTitle(floor);
        $('.units')!.innerHTML = list.map(s => `
          <button type="button" class="unit-chip ${s.status}${s.number === unit ? ' active' : ''}" data-unit="${s.number}">
            <b>${s.name}</b> ${s.size}<small>${s.statusLabel}</small>
          </button>`).join('');
        // in 3D the plan isn't on stage — offer it as a link
        const info = floorInfo(floor);
        planLink.hidden = !(info?.planSrc && root.dataset.mode === '3d');
        if (info?.planSrc) planLink.href = info.planSrc;
      }

      // the picked apartment's facts + link to its page, inside the stage right under the zoomed
      // view (it used to be a card below the floor buttons, out of sight)
      const s = suite(unit);
      card.hidden = !s;
      root.classList.toggle('has-unit', !!s);
      if (s) {
        const price = s.status === 'sold' ? '' : ` · <b>${s.price ? `от ${s.price}` : 'цена при запитване'}</b>`;
        card.innerHTML = `
          <div class="ub-text">
            <div class="ub-head"><b>${s.name}</b><span class="uc-status ${s.status}">${s.statusLabel}</span></div>
            <div class="ub-facts">${s.type} · ${s.size} · ${s.floors.length > 1 ? 'етажи' : 'етаж'} ${s.floorsText}${price}</div>
          </div>
          <a class="btn" href="${s.href}">Разпределение и цени →</a>`;
        if (opts.scroll) revealStage();
      }

      // shareable state: /obekti/sgrada-a?floor=2&unit=m4
      const url = new URL(location.href);
      floor === null ? url.searchParams.delete('floor') : url.searchParams.set('floor', String(floor));
      unit === null ? url.searchParams.delete('unit') : url.searchParams.set('unit', unit);
      history.replaceState(null, '', url);
    }

    floorBtns.forEach(b => b.addEventListener('click', () => set(b.dataset.floor ? +b.dataset.floor : null)));
    floorShapes.forEach(p => p.addEventListener('click', () => set(+p.dataset.floor!)));
    unitShapes.forEach(p => p.addEventListener('click', () => set(state.floor, p.dataset.unit!, { scroll: true })));
    back.addEventListener('click', () => set(null));
    zoomOut.addEventListener('click', () => set(state.floor));

    // zoom the floor onto the picked apartment (its outline's bounding box fills ~80% of the stage);
    // transform-origin 0 0 + translate in % of the box itself, so it works at any stage size
    function zoomTo(view: HTMLElement | undefined) {
      planViews.forEach(v => { if (v !== view) v.style.transform = ''; });
      const shape = view && state.unit ? view.querySelector<SVGPolygonElement>(`.unit-shape[data-unit="${state.unit}"]`) : null;
      zoomOut.hidden = !shape;
      if (!view) return;
      if (!shape) { view.style.transform = ''; return; }
      const p = shape.getAttribute('points')!.trim().split(/\s+/).map(xy => xy.split(',').map(Number));
      const xs = p.map(q => q[0]), ys = p.map(q => q[1]);
      const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
      // a bit less height and centred slightly higher: the info strip sits along the bottom
      const s = Math.min(3.2, 80 / (x1 - x0), 72 / (y1 - y0));
      const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
      view.style.transform = `translate(${50 - cx * s}%, ${44 - cy * s}%) scale(${s})`;
    }

    planStyle.querySelectorAll<HTMLButtonElement>('button').forEach(b => {
      b.classList.toggle('active', b.dataset.style === root.dataset.planStyle);
      b.addEventListener('click', () => {
        root.dataset.planStyle = b.dataset.style!;
        planStyle.querySelectorAll('button').forEach(x => x.classList.toggle('active', x === b));
      });
    });
    $('.units')!.addEventListener('click', e => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('.unit-chip');
      if (chip) set(state.floor, chip.dataset.unit!, { scroll: true });
    });

    function showTooltip(text: string | null, x: number, y: number) {
      tooltip.hidden = !text;
      if (text) { tooltip.textContent = text; tooltip.style.left = `${x}px`; tooltip.style.top = `${y}px`; }
    }
    const stageEl = $('.stage')!;
    function hoverLabel(el: SVGPolygonElement, text: () => string) {
      el.addEventListener('pointermove', e => {
        const r = stageEl.getBoundingClientRect();
        showTooltip(text(), e.clientX - r.left, e.clientY - r.top);
      });
      el.addEventListener('pointerleave', () => showTooltip(null, 0, 0));
    }
    floorShapes.forEach(p => hoverLabel(p, () => {
      const f = +p.dataset.floor!;
      return suitesOn(f).length ? `${floorTitle(f)} · ${freeText(freeOn(f))}` : floorTitle(f);
    }));
    unitShapes.forEach(p => hoverLabel(p, () => {
      const s = suite(p.dataset.unit!);
      return s ? `${s.name} · ${s.statusLabel.toLowerCase()}` : '';
    }));

    function setMode(mode: '3d' | 'image') {
      root.dataset.mode = mode;
      $$<HTMLButtonElement>('.mode-toggle button').forEach(b => b.classList.toggle('active', b.dataset.mode === mode));
      set(state.floor, state.unit);
    }
    $$<HTMLButtonElement>('.mode-toggle button').forEach(b => b.addEventListener('click', () => setMode(b.dataset.mode as '3d' | 'image')));

    function fallback(reason: string) {
      console.warn('[viewer] 3D unavailable →', reason);
      root.querySelector('.mode-toggle')?.remove();
      stage3d?.remove();
      setMode('image');
    }

    // floor plans are hidden at first (so lazy) — warm them up once the page has settled,
    // otherwise the first floor click shows the outlines on a blank plan for a moment
    setTimeout(() => planViews.forEach(v => { const img = v.querySelector('img'); if (img) img.loading = 'eager'; }), 1200);

    // initial state from the URL (e.g. coming back from an apartment page)
    const params = new URLSearchParams(location.search);
    const initFloor = params.get('floor') ? +params.get('floor')! : null;
    state = { floor: initFloor, unit: params.get('unit') };

    if (data.has3D && stage3d) {
      root.dataset.mode = '3d';
      const { createViewer3D, webglAvailable } = await import('../scripts/viewer3d');
      if (!webglAvailable()) fallback('no WebGL');
      else {
        try {
          view3d = await createViewer3D(stage3d, {
            suites: data.suites,
            modelUrl: data.modelUrl,
            procedural: data.procedural,
            onPickFloor: f => set(f),
            onPickUnit: u => set(state.floor, u, { scroll: true }),
            onHover: showTooltip,
            hoverText: (f, u) => {
              const s = suite(u);
              return s ? `${s.name} · ${s.statusLabel.toLowerCase()}` : `${floorTitle(f)} · ${freeText(freeOn(f))}`;
            },
          });
          stage3d.querySelector('.stage-loading')?.remove();
          if (!view3d.hasFloors) root.classList.add('no-floors');   // e.g. a house model: just orbit
          setMode('3d');
        } catch (err) {
          fallback(String(err));
        }
      }
    } else {
      setMode('image');
    }
  }
</script>

<style>
  .viewer { --stage-h: min(70vh, 640px); width: 100%; display: grid; grid-template-columns: 1fr auto; gap: 16px; }

  .stage { position: relative; height: var(--stage-h); overflow: hidden; background: var(--paper); padding: 0; }
  .stage-3d, .stage-image { position: absolute; inset: 0; }
  .stage-3d :global(canvas) { display: block; width: 100%; height: 100%; touch-action: none; }
  .stage-loading { position: absolute; inset: 0; display: grid; place-items: center; color: var(--dim); font-style: italic; }
  .viewer[data-mode='3d'] .stage-image, .viewer[data-mode='image'] .stage-3d { display: none; }

  .stage-image { display: grid; place-items: center; background: var(--paper2); }
  .plan-open .stage-image { background: #fff; }
  /* explicit size from the image ratio, so the SVG outlines sit exactly on the picture */
  .image-box { grid-area: 1 / 1; position: relative; container-type: inline-size; aspect-ratio: var(--ratio); width: min(100%, calc(var(--stage-h) * var(--ratio))); }
  .image-box[hidden] { display: none; }
  .image-box :global(img) { display: block; width: 100%; height: 100%; }
  .image-box svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .image-box polygon { vector-effect: non-scaling-stroke; cursor: pointer; transition: fill-opacity .15s; }

  .floor-shape { fill: var(--ink); fill-opacity: 0; stroke: var(--paper); stroke-width: 1.5; stroke-opacity: .8; }
  .floor-shape:hover { fill-opacity: .3; }
  .floor-shape.active { fill: var(--accent); fill-opacity: .45; stroke: var(--ink); stroke-width: 2; }

  /* apartments on the clean plan: the walls already show the boundaries, so free ones stay clear
     and only light up on hover; sold/reserved get a wash */
  .unit-shape { stroke: transparent; stroke-width: 3; fill: var(--sonar-teal); fill-opacity: 0; }
  .unit-shape:hover { fill-opacity: .07; stroke: var(--sonar-teal); }
  .unit-shape.reserved { fill: #8f8a7a; fill-opacity: .18; }
  .unit-shape.sold { fill: #8f8a7a; fill-opacity: .3; }
  .unit-shape.active { fill: var(--accent); fill-opacity: .2; stroke: var(--accent); }

  /* live text over the plan (room names + m², apartment tags) — sized to the plan, not the page */
  .rooms, .unit-tag { pointer-events: none; }
  .room {
    position: absolute; transform: translate(-50%, -50%); text-align: center; line-height: 1.15;
    color: var(--sonar-teal); font-size: clamp(6px, 1cqw, 13px); white-space: nowrap;
  }
  .room b { display: block; font-weight: 500; text-transform: uppercase; letter-spacing: .03em; font-size: .82em; }
  .room i { font-style: normal; font-weight: 600; }
  .unit-tag {
    position: absolute; transform: translate(-50%, -50%); white-space: nowrap;
    background: var(--sonar-teal); color: #fff; font-size: clamp(9px, 1.15cqw, 14px); font-weight: 600;
    padding: .15em .7em; letter-spacing: .02em;
  }
  .unit-tag.sold { background: #8f8a7a; }
  .unit-tag.reserved { background: #6f6b60; }
  .tag-short { display: none; }
  @container (max-width: 520px) {
    .room { display: none; }
    /* phones: tags shrink to the number so neighbouring apartments don't overlap */
    .tag-long { display: none; }
    .tag-short { display: inline; }
  }

  /* zoom onto an apartment */
  .plan-view { transform-origin: 0 0; transition: transform .6s cubic-bezier(.4, 0, .2, 1); }
  @media (prefers-reduced-motion: reduce) { .plan-view { transition: none; } }

  /* AI visualisation stacked exactly over the plan (same pixels); the switch picks one */
  .plan-view :global(.floor-render-img) { position: absolute; inset: 0; }
  .viewer[data-plan-style='plan'] .plan-view :global(.floor-render-img),
  .viewer[data-plan-style='plan'] .render-note,
  .viewer[data-plan-style='plan'] .rooms { display: none; }
  .viewer[data-plan-style='render'] .has-render .room { color: #fff; text-shadow: 0 0 3px rgba(0, 0, 0, .8); }
  .viewer[data-plan-style='render'] .has-render .unit-shape:not(.active):not(:hover) { fill-opacity: 0; }
  /* on the render, sold apartments fade out under a white wash instead of the grey tint */
  .viewer[data-plan-style='render'] .has-render .unit-shape.sold:not(.active) { fill: #fff; fill-opacity: .55; }
  .render-note {
    position: absolute; right: 1%; bottom: 1%; font-size: clamp(8px, .9cqw, 12px); color: var(--dim);
    background: color-mix(in srgb, #fff 80%, transparent); padding: .1em .5em; pointer-events: none;
  }

