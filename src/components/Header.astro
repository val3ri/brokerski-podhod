---
import { Image } from 'astro:assets';
import logo from '../assets/logo-transparent.png';

const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}#koi-sme-nie`, label: 'Кои сме ние' },
  { href: `${base}imoti`, label: 'Имоти' },
  { href: `${base}#kontakti`, label: 'Контакти' },
];
---

<header class="site-header">
  <a class="brand" href={base}>
    <Image src={logo} alt="" width={32} height={40} />
    Sonar
  </a>
  <nav>
    <ul>
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 28px;
    background: var(--paper);
    border-bottom: 3px solid var(--ink);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
  }
  .brand :global(img) {
    height: 34px;
    width: auto;
    display: block;
  }
  nav ul {
    display: flex;
    gap: 22px;
  }
  nav a {
    font-size: 19px;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    border-bottom-color: var(--ink);
  }
  @media (max-width: 560px) {
    .site-header { flex-wrap: wrap; padding: 12px 16px; gap: 6px; }
    .brand { font-size: 22px; gap: 6px; }
    .brand :global(img) { height: 26px; }
    nav ul { gap: 12px; }
    nav a { font-size: 15px; }
  }
</style>
